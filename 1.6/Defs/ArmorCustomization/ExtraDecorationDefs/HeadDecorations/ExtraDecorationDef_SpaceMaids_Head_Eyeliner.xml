        <defName>BEWH_DecoEyeliner_MkVII</defName>
        <label>Sacred mascara</label>
        <description>...</description>
        <iconPath>UI/Decoration/Icons/Headgear/BEWH_Deco_Eyeliner_icon</iconPath>
