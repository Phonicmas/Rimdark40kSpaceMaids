            </dataEast>
            <dataWest>
                <layer>71</layer>
            </dataWest>
        </drawData>
        <colourable>false</colourable>
        <shaderType>Cutout</shaderType>
        <useParentColourAsDefault>true</useParentColourAsDefault>
        <decorationType>BEWH_DecoCategory_Misc</decorationType>
    </Core40k.ExtraDecorationDef>

