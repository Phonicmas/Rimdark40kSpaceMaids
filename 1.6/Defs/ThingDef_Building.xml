<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Picnic Table -->
    <ThingDef ParentName="TableGatherSpotBase" Name="BEWH_PicnicTableBase">
        <defName>BEWH_PicnicTable</defName>
        <label>café table</label>
		<description>This specialized café table is crafted from glistening, easy-clean materials. Built to maintain its stunning appearance through whatever the day demands, whether that is a quiet afternoon service or the immediate aftermath of a firefight.</description>
        <graphicData>
            <texPath>Things/Building/PicnicTable</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <drawSize>(1.2, 1.2)</drawSize>
			<drawOffset>(0, 0, -0.1)</drawOffset>
        </graphicData>
        <uiIconScale>0.8</uiIconScale>
		<altitudeLayer>Building</altitudeLayer>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <WorkToBuild>750</WorkToBuild>
            <Mass>5</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>4</Beauty>
            <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
        </statBases>
        <size>(1,1)</size>
        <stuffCategories Inherit="False"/>
        <costList>
            <Steel>20</Steel>
        </costList>
        <designationCategory Inherit="False">BEWH_RimDarkCategory</designationCategory>
    </ThingDef>

    <!-- Picnic Stool -->
    <ThingDef ParentName="FurnitureWithQualityBase" Name="BEWH_PicnicStoolBase">
        <defName>BEWH_PicnicStool</defName>
        <label>café stool</label>
        <description>Standard issue Astartes café stool, reinforced to bear the weight of power armor and fitted with a dampening cushion for the comfort of whoever sits down. It is sturdy, it is practical, and it is considerably more pleasant to sit on than anything else available on the battlefield.</description>
        <replaceTags>
            <li>Chair</li>
        </replaceTags>
        <graphicData>
            <texPath>Things/Building/BEWH_PicnicStool</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.75, 0.75)</drawSize>
			<drawOffset>(0, 0, -0.1)</drawOffset>
            <shadowData>
                <volume>(0.5, 0.25, 0.15)</volume>
				<offset>(0,0,-0.15)</offset>
            </shadowData>
        </graphicData>
		<uiIconScale>0.75</uiIconScale>
        <altitudeLayer>Building</altitudeLayer>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <WorkToBuild>450</WorkToBuild>
            <Mass>3</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>4</Beauty>
            <Comfort>0.7</Comfort>
            <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
        </statBases>
        <socialPropernessMatters>true</socialPropernessMatters>
        <costList>
            <Steel>30</Steel>
			<Cloth>10</Cloth>
        </costList>
        <pathCost>30</pathCost>
        <designationHotKey>Misc6</designationHotKey>
        <uiOrder>2400</uiOrder>
        <fillPercent>0.20</fillPercent>
        <building>
            <isSittable>true</isSittable>
        </building>
        <uiIconOffset>(0, -0.05)</uiIconOffset>
        <designationCategory Inherit="False">BEWH_RimDarkCategory</designationCategory>
    </ThingDef>

    <ThingDef ParentName="BEWH_PicnicTableBase">
        <defName>BEWH_PicnicTableDropPod</defName>
        <stuffCategories Inherit="False"/>
        <costList Inherit="False" />
        <designationCategory Inherit="False" />
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Lifespan">
                <lifespanTicks>30000</lifespanTicks>
                <expireEffect>RaisedRock_Collapse</expireEffect>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BEWH_PicnicStoolBase">
        <defName>BEWH_PicnicStoolDropPod</defName>
        <stuffCategories Inherit="False"/>
        <costList Inherit="False" />
        <designationCategory Inherit="False" />
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Lifespan">
                <lifespanTicks>30000</lifespanTicks>
                <expireEffect>RaisedRock_Collapse</expireEffect>
            </li>
        </comps>
    </ThingDef>

</Defs>